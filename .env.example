# --- База данных ---
# Продакшен: postgresql://user:password@host:5432/myagko?sslmode=require
# Локально без Docker: pglite://.data/dev (Postgres в WASM, файл в .data)
DATABASE_URL=pglite://.data/dev

# --- Приложение ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32+ случайных байта. HMAC-ключ для rate limit: IP и телефон не хранятся в открытом виде.
AUTH_SECRET=

# --- Первый владелец (только для npm run db:seed) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
# true — требовать смену пароля при первом входе после сида.
# По умолчанию false: демо-вход сразу в заявки. CLI-сброс всегда требует смену.
ADMIN_MUST_CHANGE_PASSWORD=false

# --- Фото ---
# local — файлы в PHOTO_STORAGE_DIR (VPS)
# s3 — S3-совместимое хранилище, приватный бакет (Vercel + R2)
PHOTO_STORAGE=local
PHOTO_STORAGE_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Docker Compose на VPS ---
# В файле .env рядом с docker-compose.yml:
POSTGRES_DB=myagko
POSTGRES_USER=myagko
POSTGRES_PASSWORD=
DOMAIN=
